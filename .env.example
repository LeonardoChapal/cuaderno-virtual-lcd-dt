# ---------------------------------------------------------------------------
# Cuaderno Virtual LCD — variables de entorno
# Copia este archivo como `.env.local` y rellena los valores reales.
# NUNCA subas `.env.local` al repositorio (ya está en .gitignore).
# ---------------------------------------------------------------------------

# --- Base de datos: Neon Postgres -----------------------------------------
# Cadena de conexión "pooled" de Neon (la que termina en -pooler...).
# Neon → tu proyecto → Connection Details → Connection string.
DATABASE_URL="postgresql://usuario:contrasena@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require"

# SOLO EN LOCAL: host de tu RAMA de Neon de desarrollo (sin usuario ni clave).
# La guarda (src/lib/db-guard.ts) aborta si el host de DATABASE_URL no coincide.
# En Vercel no se define ni se usa (la guarda se desactiva con VERCEL_ENV).
DB_EXPECTED_HOST="ep-xxxx-pooler.region.aws.neon.tech"

# --- Autenticación: Auth.js (NextAuth v5) ---------------------------------
# Secreto para firmar la sesión. Genera uno con:  npx auth secret
AUTH_SECRET="cambia-esto-por-un-secreto-largo-y-aleatorio"

# Credenciales del ÚNICO administrador.
# El usuario por defecto es "admin". La contraseña se guarda HASHEADA en la
# base de datos al ejecutar `npm run db:seed`.
#
# ADMIN_PASSWORD solo la lee `npm run db:seed` (para crear el hash). El sitio
# ya no la usa al iniciar sesión: la comprobación es siempre contra la base.
#
# NUNCA pongas aquí la contraseña real: este archivo se sube al repositorio.
# Elige una propia y ponla solo en .env.local y en Vercel. Mínimo 8 caracteres.
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="pon-aqui-una-contrasena-propia"

# --- Almacenamiento de archivos: Vercel Blob ------------------------------
# Vercel → tu proyecto → Storage → Blob → conectar. Vercel inyecta esta
# variable automáticamente en producción; en local cópiala aquí.
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_xxxxxxxxxxxxxxxx"
# En local usa el token de un Blob store de DESARROLLO, nunca el de producción.

# URL pública del sitio, para la vista previa al compartir y el sitemap
# (opcional). Si no se define, se usa la de Vercel (dominio de producción o
# URL del despliegue) y en local http://localhost:3000.
# SITE_URL="https://tu-dominio.com"

# Tamaño máximo por archivo subido, en MB (opcional; por defecto 300).
MAX_UPLOAD_MB="300"
