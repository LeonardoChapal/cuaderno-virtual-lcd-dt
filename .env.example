# ---------------------------------------------------------------------------
# Cuaderno Virtual LCD — variables de entorno
# Copia este archivo como `.env.local` y rellena los valores reales.
# NUNCA subas `.env.local` al repositorio (ya está en .gitignore).
# ---------------------------------------------------------------------------

# --- Base de datos: Neon Postgres -----------------------------------------
# Cadena de conexión "pooled" de Neon (la que termina en -pooler...).
# Neon → tu proyecto → Connection Details → Connection string.
DATABASE_URL="postgresql://usuario:contrasena@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require"

# --- Autenticación: Auth.js (NextAuth v5) ---------------------------------
# Secreto para firmar la sesión. Genera uno con:  npx auth secret
AUTH_SECRET="cambia-esto-por-un-secreto-largo-y-aleatorio"

# Credenciales del ÚNICO administrador.
# El usuario por defecto es "admin". La contraseña se guarda HASHEADA en la
# base de datos al ejecutar `npm run db:seed`.
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="cuaderno2026"

# --- Almacenamiento de archivos: Vercel Blob ------------------------------
# Vercel → tu proyecto → Storage → Blob → conectar. Vercel inyecta esta
# variable automáticamente en producción; en local cópiala aquí.
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_xxxxxxxxxxxxxxxx"
